# Copier ce fichier en .env, puis remplir les valeurs.
# Les secrets se génèrent avec : npm run keys:generate

NODE_ENV=development

# --- Base de données (Neon en dev) --------------------------------------------
# Une seule base, un schéma PostgreSQL par service (séparables plus tard).
# URL « pooled » (avec -pooler dans l'hôte) pour l'application, URL directe pour les migrations.
API_DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/fricadev?sslmode=require&connect_timeout=30&pool_timeout=30&schema=app&pgbouncer=true"
API_DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/fricadev?sslmode=require&connect_timeout=30&pool_timeout=30&schema=app"
AUTH_DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/fricadev?sslmode=require&connect_timeout=30&pool_timeout=30&schema=identity&pgbouncer=true"
AUTH_DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/fricadev?sslmode=require&connect_timeout=30&pool_timeout=30&schema=identity"
# pg-boss a besoin d'une connexion directe (pas de pooler)
WORKER_DATABASE_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/fricadev?sslmode=require"

# --- API ---------------------------------------------------------------------
API_PORT=4000
API_CORS_ORIGINS=http://localhost:5173
API_AUDIENCE=https://api.fricadev.local
# Photos de profil : disque local (dev, VPS avec volume) ou stockage objet S3 (Datacloud)
STORAGE_DRIVER=local
UPLOADS_DIR=uploads
PUBLIC_UPLOADS_URL=http://localhost:4000/uploads
# Si STORAGE_DRIVER=s3 :
# S3_ENDPOINT=https://s3.exemple-datacloud
# S3_BUCKET=fricadev
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://fricadev.s3.exemple-datacloud

# --- Identité (OpenID Connect) -----------------------------------------------
AUTH_PORT=4001
AUTH_ISSUER=http://localhost:4001
AUTH_COOKIE_KEYS=
AUTH_JWKS=

# --- Site web ----------------------------------------------------------------
WEB_URL=http://localhost:5173
WEB_CLIENT_ID=fricadev-web
WEB_CLIENT_SECRET=
WEB_SESSION_SECRET=
# Appels serveur à serveur (différents dans Docker)
AUTH_INTERNAL_URL=http://localhost:4001
API_INTERNAL_URL=http://localhost:4000

# Connexion GitHub (facultatif) : OAuth App avec callback {AUTH_ISSUER}/interaction
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
